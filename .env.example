# Frontend: vacío en Netlify o con `netlify dev` (mismo origen; rewrite a la función).
# Solo pon URL si el API de correo está en otro dominio (ej. otro backend).
VITE_API_URL=

# SMTP — en local las usa `netlify dev` desde este archivo.
# En Netlify: Site settings → Environment variables (mismos nombres, sin VITE_).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=contraseña_de_aplicacion
SMTP_FROM=tu_correo@gmail.com
EMAIL_TO=tu_correo@gmail.com
