# =============================================================================
# PLANTILLA — NO subas a Git un .env con valores reales (usa .gitignore).
# Para Netlify: Site settings → Environment variables → copia cada clave/valor.
# =============================================================================

# Vacío en el mismo sitio Netlify (rewrite /emails/contact → función).
# Solo si el API de correo está en OTRO dominio:
# VITE_API_URL=https://otro-dominio.com
VITE_API_URL=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=reemplaza_por_contraseña_de_aplicacion_de_google
SMTP_FROM=tu_correo@gmail.com
EMAIL_TO=donde_quieres_recibir_los_mensajes@gmail.com
